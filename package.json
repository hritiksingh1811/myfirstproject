{
  "name": "myfirstproject",
  "version": "1.0.0",
  "private": true,
  "description": "Employee onboarding & offboarding app (React + Node.js/Express)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
